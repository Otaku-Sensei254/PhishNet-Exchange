{
  "manifest_version": 3,
  "name": "PhishNet Exchange",
  "version": "1.0.0",
  "description": "Real-time phishing and malware URL protection powered by PhishNet Exchange.",
  "permissions": ["webNavigation", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/index.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/warning/index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
